[0.0, "o", "\u001b[2J\u001b[HКурсы CoinGecko из API.\r\n"]
[4.0, "o", "\u001b[2J\u001b[H> update-rates --source coingecko\r\nОбновлено курсов: 3\r\n"]
[8.0, "o", "\u001b[2J\u001b[H> show-rates --top 2\r\n+---------+----------------+----------------------------------+\r\n|   Пара  |      Курс      |         Обновлено (UTC)          |\r\n+---------+----------------+----------------------------------+\r\n| BTC_USD | 81272.00000000 | 2026-10-23T14:32:30.429626+00:00 |\r\n| ETH_USD | 2388.07000000  | 2026-10-23T14:32:30.429626+00:00 |\r\n+---------+----------------+----------------------------------+\r\n"]
[12.0, "o", "\u001b[2J\u001b[H> register --username student --password demo1234\r\nПользователь 'student' зарегистрирован (id=1). Выполните login.\r\n"]
[16.0, "o", "\u001b[2J\u001b[H> login --username student --password demo1234\r\nВы вошли как 'student'\r\n"]
[20.0, "o", "\u001b[2J\u001b[H> show-portfolio\r\nПортфель пользователя 'student' (база: USD):\r\nПортфель пуст.\r\n+--------+--------+----------------+\r\n| Валюта | Баланс | Стоимость, USD |\r\n+--------+--------+----------------+\r\n+--------+--------+----------------+\r\nИТОГО: 0.00 USD\r\n"]
[24.0, "o", "\u001b[2J\u001b[H> buy --currency BTC --amount 0.05\r\nПокупка выполнена: 0.0500 BTC по курсу 81272.0000 USD/BTC\r\nБаланс: 0.0000 → 0.0500\r\nОценочная стоимость: 4063.60 USD\r\n"]
[28.0, "o", "\u001b[2J\u001b[H> sell --currency BTC --amount 0.01\r\nПродажа выполнена: 0.0100 BTC по курсу 81272.0000 USD/BTC\r\nБаланс: 0.0500 → 0.0400\r\nОценочная стоимость: 812.72 USD\r\n"]
[32.0, "o", "\u001b[2J\u001b[H> show-portfolio\r\nПортфель пользователя 'student' (база: USD):\r\n+--------+--------+----------------+\r\n| Валюта | Баланс | Стоимость, USD |\r\n+--------+--------+----------------+\r\n|  BTC   | 0.0400 |    3250.88     |\r\n+--------+--------+----------------+\r\nИТОГО: 3,250.88 USD\r\n"]
[36.0, "o", "\u001b[2J\u001b[H> get-rate --from USD --to BTC\r\nКурс USD→BTC: 0.00001230 (обновлено: 2026-10-23T14:32:30.429626+00:00)\r\nОбратный курс: 81272.00000000\r\n"]
[40.0, "o", "\u001b[2J\u001b[H> sell --currency BTC --amount 10\r\nОшибка: Недостаточно средств: доступно 0.04 BTC, требуется 10.0 BTC\r\n"]
[44.0, "o", "\u001b[2J\u001b[H> buy --currency ABC --amount 1\r\nНеизвестная валюта 'ABC'\r\nПоддерживаются: USD, EUR, GBP, RUB, BTC, ETH, SOL\r\n"]
